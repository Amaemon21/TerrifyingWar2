  <ItemName>k__BackingField: Drake-12
  <ItemDescription>k__BackingField: "\u041C\u043E\u0449\u043D\u044B\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442
    \u0441 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
    \u0438 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0443\u0431\u043E\u0439\u043D\u043E\u0439 \u0441\u0438\u043B\u043E\u0439. \u041F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
    \u0434\u043B\u044F \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0438 \u0434\u0430\u043B\u044C\u043D\u0438\u0445
    \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0439, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u043D\u0430\u0434\u0435\u0436\u043D\u043E\u0441\u0442\u0438 \u0438 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0439
    \u043E\u0442\u0434\u0430\u0447\u0435. \u0418\u0434\u0435\u0430\u043B\u0435\u043D
    \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u0438\u0449\u0435\u0442
    \u0431\u0430\u043B\u0430\u043D\u0441 \u043C\u0435\u0436\u0434\u0443 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E
    \u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u043C\u043E\u0449\u044C\u044E."
