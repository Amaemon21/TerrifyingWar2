    \u0443\u0441\u043B\u043E\u0432\u0438\u0439. \u041A\u0430\u043B\u0438\u0431\u0440
    .308 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442
    \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0438 \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u044E\u0449\u0443\u044E \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C.
    \u041E\u0441\u043D\u0430\u0449\u0435\u043D\u0430 \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u043C
