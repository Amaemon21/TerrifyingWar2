    \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043C\u043E\u0434\u0443\u043B\u0435\u0439, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442
